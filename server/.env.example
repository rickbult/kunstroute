# Kopieer dit bestand naar server/.env en vul echte waarden in.
# server/.env staat in .gitignore en mag NOOIT gecommit worden.

# MongoDB-connectiestring (bijv. MongoDB Atlas).
MONGODB_URI=mongodb+srv://<gebruiker>:<wachtwoord>@<cluster>.mongodb.net/kunstroute?retryWrites=true&w=majority

# Geheime sleutel voor JWT-tokens. Verplicht — de server stopt als deze ontbreekt.
# Genereer een sterke waarde met: openssl rand -base64 64
JWT_SECRET=

# Poort waarop de Node/Express-server luistert (standaard 5000).
PORT=5000
